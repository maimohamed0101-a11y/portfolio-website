# Copy to .env.local and fill in. Never commit real values.

# Where contact-form submissions are stored (JSON file). Defaults to ./data
# On serverless hosts with a read-only filesystem, point this at a writable path (e.g. /tmp)
# or rely on email notifications instead.
SUBMISSIONS_DIR=

# Optional email notifications via Resend (https://resend.com).
# If RESEND_API_KEY is empty, submissions are stored but no email is sent.
RESEND_API_KEY=
# A sender on a domain you have verified in Resend, e.g. "Portfolio <hello@yourdomain.com>"
CONTACT_FROM_EMAIL=
# Recipient for notifications. Defaults to the email in content/site.json
CONTACT_TO_EMAIL=

# Public base URL, used for metadata (e.g. https://maimohamed.com)
NEXT_PUBLIC_SITE_URL=
